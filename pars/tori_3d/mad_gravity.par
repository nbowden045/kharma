# The Magnetically Arrested Disk (MAD) accretion flow
# This is a normal large-disk (20/41 r_g) MAD with gamma=5/3,
# in modified theories of gravity (dCS / EdGB)

<parthenon/job>
problem_id = torus
archive_parameters = timestamp

<parthenon/mesh>
nx1 = 128
nx2 = 64
nx3 = 64

<parthenon/meshblock>
nx1 = 128
nx2 = 64
nx3 = 64

<coordinates>
base = dcs_ks
theory = dcs # valid strings - 'gr', 'dcs', 'edgb'
zeta = 0.1

transform = fmks
r_out = 1000
a = 0.5
hslope = 0.3

<parthenon/time>
tlim = 20000.0
nlim = -1

<torus>
rin = 20.0
rmax = 41.0
# Tilt in degrees, rotates initial torus CC about +y. YMMV.
tilt = 0.

<perturbation>
u_jitter = 0.04

<b_field>
solver = face_ct
type = mad
beta_min = 100.

<GRMHD>
cfl = 0.8
gamma = 1.666667

<flux>
type = llf
# WENO5 Adaptive Order "At Home" --
# WENO5Z with fallback to linear recon in difficult regions
reconstruction = weno5_linear

<driver>
type = kharma
# Second sync at the end of each step. This is still
# enabled by default, but with KHARMA driver and Face-CT
# it's been safe to disable in tests. YMMV
two_sync = false

<boundaries>
inner_x2 = reflecting
outer_x2 = reflecting
# This reduces the polar "wake," but shrinks the timestep,
# and has caused instabilities. YMMV.
#excise_polar_flux = true
# Reconnect phi component of B at the pole, as if it were one zone
# Dramatically reduces instabilities
reconnect_B3_inner_x2 = true
reconnect_B3_outer_x2 = true

<floors>
frame            = drift
rho_min_geom     = 1e-6
u_min_geom       = 1e-8
bsq_over_rho_max = 1e3
bsq_over_u_max   = 1e4
gamma_max        = 32

<fofc>
on = false

<debug>
verbose = 1
extra_checks = 1
flag_verbose = 0

<parthenon/output0>
file_type = hdf5
dt = 5.0
single_precision_output = true
variables = prims, divB, jcon, fflag, pflag

<parthenon/output1>
file_type = rst
dt = 100.0

<parthenon/output2>
file_type = hst
dt = 0.1

# This outputs a geometry file, similar to iharm3d's old 'grid.h5'
# Not needed for pyharm analysis in Kerr metrics, but useful in
# a bunch of other contexts.
<parthenon/output3>
file_type = hdf5
dt = 1e20
single_precision_output = false
# If you want the convenience and hate disk space, you can add these
# variables to "normal" dump files like output0 too.
variables = coords.Xnative, coords.Xsph, &
            coords.gcon, coords.gcov, coords.gdet, coords.lapse, &
            coords.conn
