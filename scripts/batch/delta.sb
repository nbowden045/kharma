#!/bin/bash
# Admin stuff
#SBATCH -J KHARMA
#SBATCH -t 24:00:00
#SBATCH -o "out-%j.txt"
#SBATCH --account=bfyx-delta-gpu
#SBATCH --constraint="work"

#SBATCH --gpus=4
#SBATCH --partition=gpuA100x4
#SBATCH --mem-per-gpu=40GB
#SBATCH --cpus-per-gpu=4
#SBATCH --gpu-bind=closest

#SBATCH --gpus-per-node=1

# NCSA Delta run script

export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_GPU_MANAGED_MEMORY_SUPPORT_ENABLED=1

# When running on one node, these are supposed to map all GPUs to
# its single NIC for communication, preventing an issue. YMMV.
#export MPICH_OFI_NIC_VERBOSE=1
#export MPICH_OFI_NUM_NICS=1
#export MPICH_OFI_NIC_POLICY=USER
#export MPICH_OFI_NIC_MAPPING="0:0-3"

# Choose the kharma from compiled options in order of preference
KHARMA_DIR=${KHARMA_DIR:-"$HOME/Code/kharma"}

# Load any defaults/modules from the machine file
HOST=$(hostname -f)
ARGS=$(cat $KHARMA_DIR/make_args)
for machine in $KHARMA_DIR/machines/*.sh
do
  source $machine
done

export KOKKOS_MAP_DEVICE_ID_BY=mpi_rank

# Run with srun
srun --ntasks-per-gpu=1 $KHARMA_DIR/kharma.cuda -t 23:50:00 -d dumps_kharma "$@"
